PORT=3000
NODE_ENV=development

# Domínio público do servidor, com https:// (ex: https://api.seudominio.com)
PUBLIC_BASE_URL=

# Steam Web API key gratuita: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Gerar com: openssl rand -hex 32
JWT_SECRET=

# Lista de Steam IDs (steamid64) autorizados a logar, separados por vírgula
ALLOWED_STEAM_IDS=
